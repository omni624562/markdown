{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oMarker",
  "identifier": "io.github.omni624562.markdown",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "oMarker",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 400,
        "center": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http: mdimg: http://mdimg.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost mdimg: http://mdimg.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
